# Maintainer: aronkv <120031218+aronkv@users.noreply.github.com>
#
# To release: tag vX.Y.Z on GitHub, set pkgver, `updpkgsums`,
# `makepkg --printsrcinfo > .SRCINFO`, push both to the AUR repo.
pkgname=crabseek
pkgver=0.2.0
pkgrel=1
pkgdesc="A fast Soulseek client for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/aronkv/crabseek"
license=('MIT')
depends=('libgcc' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f214277fe2d75a842cc3b171931bc36e412ec6b2ad9a0ff2235df543fa4e5c38')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/crabseek "$pkgdir/usr/bin/crabseek"
    sed 's|@BIN@|/usr/bin/crabseek|g' packaging/systemd/crabseek.service |
        install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/crabseek.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
